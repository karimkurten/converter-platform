{
  "name": "convertnow",
  "version": "1.0.0",
  "description": "ConvertNow.ca — Free Online Unit Converter",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"const fs=require('fs');const v='v'+Date.now();const t=fs.readFileSync('public/sw.template.js','utf8');if(!t.includes('__BUILD_VERSION__')){console.error('sw.template.js missing __BUILD_VERSION__ placeholder');process.exit(1);}fs.writeFileSync('public/sw.js',t.replace(/__BUILD_VERSION__/g,v));console.log('SW cache version:',v);\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "critters": "^0.0.23",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  }
}
